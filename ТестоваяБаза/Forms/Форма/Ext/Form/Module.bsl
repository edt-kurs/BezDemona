КонецПроцедуры

&НаКлиенте
Процедура УдалитьДанные(Команда)
	УдалитьДанныеКрупныхРегистровДоДатыНаСервере();
КонецПроцедуры

Процедура УдалитьДанныеКрупныхРегистровДоДатыНаСервере()
	ГраничнаяДата = Дата(2021, 1, 1);
	РазмерПакетаРегистрНакопления = 500;
	РазмерПакетаРегистрСведений = 10000;
	РазмерПакетаДокументы = 2000;

	УдалитьДанныеРегистровНакопленияДоДаты(ГраничнаяДата, РазмерПакетаРегистрНакопления);
	УдалитьДанныеРегистровСведенийДоДаты(ГраничнаяДата, РазмерПакетаРегистрСведений);
	УдалитьДокументыДоДаты(ГраничнаяДата, РазмерПакетаДокументы);
КонецПроцедуры

&НаСервере
Процедура УдалитьДанныеРегистровНакопленияДоДаты(ГраничнаяДата, РазмерПакета)
	УдалитьДвиженияРегистраНакопленияПакетами("БалансТП", ГраничнаяДата, РазмерПакета);
	УдалитьДвиженияРегистраНакопленияПакетами("БалансРеверсТП", ГраничнаяДата, РазмерПакета);
	УдалитьДвиженияРегистраНакопленияПакетами("ЭнергияСИ", ГраничнаяДата, РазмерПакета);
КонецПроцедуры

&НаСервере
Процедура УдалитьДвиженияРегистраНакопленияПакетами(ИмяРегистра, ГраничнаяДата, РазмерПакета)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(РазмерПакета, "ЧГ=0") + "
	|	РАЗЛИЧНЫЕ
	|	ДвиженияРегистра.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления." + ИмяРегистра + " КАК ДвиженияРегистра
	|ГДЕ
	|	ДвиженияРегистра.Период < &ГраничнаяДата";

	Запрос.УстановитьПараметр("ГраничнаяДата", ГраничнаяДата);

	Пока Истина Цикл
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		КоличествоОбработанных = 0;

		Пока Выборка.Следующий() Цикл
			УдалитьДвиженияОдногоРегистраНакопленияДоДаты(ИмяРегистра, Выборка.Регистратор, ГраничнаяДата);
			КоличествоОбработанных = КоличествоОбработанных + 1;
		КонецЦикла;

		Если КоличествоОбработанных = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УдалитьДвиженияОдногоРегистраНакопленияДоДаты(ИмяРегистра, Регистратор, ГраничнаяДата)
	НаборЗаписей = Неопределено;
	Если ИмяРегистра = "БалансТП" Тогда
		НаборЗаписей = РегистрыНакопления.БалансТП.СоздатьНаборЗаписей();
	ИначеЕсли ИмяРегистра = "БалансРеверсТП" Тогда
		НаборЗаписей = РегистрыНакопления.БалансРеверсТП.СоздатьНаборЗаписей();
	ИначеЕсли ИмяРегистра = "ЭнергияСИ" Тогда
		НаборЗаписей = РегистрыНакопления.ЭнергияСИ.СоздатьНаборЗаписей();
	Иначе
		Возврат;
	КонецЕсли;

	УдалитьДвиженияНабораПоРегистраторуДоДаты(НаборЗаписей, Регистратор, ГраничнаяДата);
КонецПроцедуры

&НаСервере
Процедура УдалитьДвиженияНабораПоРегистраторуДоДаты(НаборЗаписей, Регистратор, ГраничнаяДата)
	НаборЗаписей.Отбор.Регистратор.Установить(Регистратор);
	НаборЗаписей.Прочитать();

	ЕстьУдаление = Ложь;
	Индекс = НаборЗаписей.Количество() - 1;

	Пока Индекс >= 0 Цикл
		СтрокаНабора = НаборЗаписей[Индекс];
		Если СтрокаНабора.Период < ГраничнаяДата Тогда
			НаборЗаписей.Удалить(СтрокаНабора);
			ЕстьУдаление = Истина;
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	Если ЕстьУдаление Тогда
		НаборЗаписей.Записать();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьДанныеРегистровСведенийДоДаты(ГраничнаяДата, РазмерПакета)
	УдалитьДанныеРегистраСведенийОтчётОПППЭЭ(ГраничнаяДата, РазмерПакета);
	УдалитьДанныеРегистраСведенийРавновесныеЦены(ГраничнаяДата, РазмерПакета);
	УдалитьДанныеРегистраСведенийИнтервальныеПоОбъемам(ГраничнаяДата, РазмерПакета);
	УдалитьДанныеРегистраСведенийИнтервальныеПоОбъемамПоТП(ГраничнаяДата, РазмерПакета);
	УдалитьДанныеРегистраСведенийПрофильЗакрытияМесяца(ГраничнаяДата, РазмерПакета);
КонецПроцедуры

&НаСервере
Процедура УдалитьДанныеРегистраСведенийОтчётОПППЭЭ(ГраничнаяДата, РазмерПакета)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(РазмерПакета, "ЧГ=0") + "
	|	ОтчетОПППЭЭ.Дата КАК Дата,
	|	ОтчетОПППЭЭ.НачальныйУзел КАК НачальныйУзел,
	|	ОтчетОПППЭЭ.КонечныйУзел КАК КонечныйУзел,
	|	ОтчетОПППЭЭ.Ветвь КАК Ветвь,
	|	ОтчетОПППЭЭ.Час КАК Час
	|ИЗ
	|	РегистрСведений.ОтчётОПППЭЭПоВетвямРасчетнойМодели КАК ОтчетОПППЭЭ
	|ГДЕ
	|	ОтчетОПППЭЭ.Дата < &ГраничнаяДата";

	Запрос.УстановитьПараметр("ГраничнаяДата", ГраничнаяДата);

	Пока Истина Цикл
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Обработано = 0;

		Пока Выборка.Следующий() Цикл
			НаборЗаписей = РегистрыСведений.ОтчётОПППЭЭПоВетвямРасчетнойМодели.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Дата.Установить(Выборка.Дата);
			НаборЗаписей.Отбор.НачальныйУзел.Установить(Выборка.НачальныйУзел);
			НаборЗаписей.Отбор.КонечныйУзел.Установить(Выборка.КонечныйУзел);
			НаборЗаписей.Отбор.Ветвь.Установить(Выборка.Ветвь);
			НаборЗаписей.Отбор.Час.Установить(Выборка.Час);
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			НаборЗаписей.Записать();
			Обработано = Обработано + 1;
		КонецЦикла;

		Если Обработано = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УдалитьДанныеРегистраСведенийРавновесныеЦены(ГраничнаяДата, РазмерПакета)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(РазмерПакета, "ЧГ=0") + "
	|	РавновесныеЦены.Дата КАК Дата,
	|	РавновесныеЦены.Узел КАК Узел,
	|	РавновесныеЦены.Час КАК Час,
	|	РавновесныеЦены.СубъектРФ КАК СубъектРФ
	|ИЗ
	|	РегистрСведений.РавновесныеЦеныВНаиболееКрупныхУзлах КАК РавновесныеЦены
	|ГДЕ
	|	РавновесныеЦены.Дата < &ГраничнаяДата";

	Запрос.УстановитьПараметр("ГраничнаяДата", ГраничнаяДата);

	Пока Истина Цикл
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Обработано = 0;

		Пока Выборка.Следующий() Цикл
			НаборЗаписей = РегистрыСведений.РавновесныеЦеныВНаиболееКрупныхУзлах.СоздатьНаборЗаписей();
