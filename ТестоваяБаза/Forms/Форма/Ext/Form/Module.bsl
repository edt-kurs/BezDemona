&НаСервере
Процедура УдалитьДокументыПакетами(ИмяДокумента, ГраничнаяДата, РазмерПакета)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(РазмерПакета, "ЧГ=0") + "
	|	Док.Ссылка КАК Ссылка
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Док
	|ГДЕ
	|	Док.Дата < &ГраничнаяДата
	|	И НЕ Док.ПометкаУдаления";

	Запрос.УстановитьПараметр("ГраничнаяДата", ГраничнаяДата);

	Пока Истина Цикл
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Обработано = 0;

		Пока Выборка.Следующий() Цикл
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();

			Если ДокументОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Если ДокументОбъект.Проведен Тогда
				ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			КонецЕсли;

			//ДокументОбъект.Удалить();
			Обработано = Обработано + 1;
		КонецЦикла;

		Если Обработано = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
